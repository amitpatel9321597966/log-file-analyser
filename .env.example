# LogLense Frontend Environment Variables

# Backend API URL (for local dev: http://127.0.0.1:8000, for production: https://log-file-analyser-backend.onrender.com)
VITE_API_URL=http://127.0.0.1:8000

# Google OAuth Client ID (optional)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
